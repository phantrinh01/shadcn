rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Task attachments: authenticated users only; files under 50 MB.
    // Rules cannot reliably check the extension; .exe/.sh/.bat are blocked
    // on the client (see validateFile) and best-effort here via the file name.
    match /tasks/{taskId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && !fileName.matches('(?i).*\\.(exe|sh|bat)$');
      allow delete: if request.auth != null;
    }
  }
}
